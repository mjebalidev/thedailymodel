# ── LLM (Gemini free tier) ───────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Ordered fallback chain (smartest first, most-available last). Each call tries
# them in order, permanently skips any that 404 / are inaccessible, and retries
# transient rate-limits before moving on.
# Verify the exact IDs your key can access with:  uv run python -m app.cli models
# Tip: prefer the "-latest" ALIASES — pinned versions like gemini-2.5-flash get
# closed to new accounts ("no longer available to new users"), the aliases don't.
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Optional single-model override, prepended to the chain (leave empty to use the list).
GEMINI_MODEL=

# When true (or when GEMINI_API_KEY is empty), the pipeline uses a deterministic
# mock LLM so you can develop end-to-end without any API key.
USE_MOCK_LLM=true

# ── Pipeline tuning ──────────────────────────────────────────────────────
# Only consider items published within this many hours.
LOOKBACK_HOURS=48
# Max candidate articles fetched before analysis.
MAX_CANDIDATES=40
# Max articles kept in the final edition.
MAX_ARTICLES=12
# Also query the web (no key needed) on top of RSS feeds.
ENABLE_WEB_SEARCH=true
# Comma-separated ddgs news backends queried per web-search query. Multiple
# backends make discovery resilient: if one is throttled from the server IP,
# the others still return results. Valid news backends: duckduckgo, bing, yahoo.
WEB_SEARCH_BACKENDS=duckduckgo, bing, yahoo

# Relevance filter — an agent that scores each candidate and drops the noise.
ENABLE_RELEVANCE_FILTER=true
# 0-100: candidates scoring below this are discarded before analysis.
RELEVANCE_MIN_SCORE=50

# Languages — first is the base (edition is written in it); the rest are produced
# by the translation agent. ISO 639-1 codes, comma-separated.
LANGUAGES=en,fr,de
ENABLE_TRANSLATION=true

# ── Trigger security ─────────────────────────────────────────────────────
# Secret required to POST /api/pipeline/trigger from an external cron.
# Leave empty to allow unauthenticated triggering (fine for local dev).
TRIGGER_SECRET=

# Run the built-in APScheduler daily cron (0 = off, useful in prod).
ENABLE_SCHEDULER=false
# Cron time (24h, server local time) for the daily edition.
DAILY_CRON_HOUR=4
DAILY_CRON_MINUTE=0

# ── Storage / server ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./ai_news.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Editions older than this many days are purged after each pipeline run,
# keeping the DB bounded (0 = keep everything forever).
# Manual purge: uv run python -m app.cli cleanup [--days N]
RETENTION_DAYS=365
